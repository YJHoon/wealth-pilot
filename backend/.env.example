# 데이터베이스
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wealthpilot_dev

# 암호화 (AES-256, 32바이트 base64 인코딩 키)
# 생성 방법: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=your-base64-encoded-32byte-key-here

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# NextAuth 연동
NEXTAUTH_SECRET=

# CORS (프론트엔드 URL, 쉼표 구분)
CORS_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry
SENTRY_DSN=

# 개발용: 인증 비활성화 (true면 로그인 없이 API 사용 가능)
AUTH_DISABLED=false

# 싱글유저 모드: 허용된 이메일 (설정하면 이 이메일만 로그인 가능, 비워두면 제한 없음)
ALLOWED_EMAIL=

# KIS API (한국투자증권) — 모의투자
KIS_PAPER_ACCOUNT_NUMBER=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# KIS API (한국투자증권) — 실전
KIS_LIVE_ACCOUNT_NUMBER=
KIS_LIVE_ACCOUNT_PRODUCT_CODE=
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=

# 자동매매 글로벌 킬 스위치 (true=활성)
TRADING_ENABLED=false

# Stage 3: LLM 어드바이저
# paper 모드 전용 — live 모드 LLM 발주는 코드에서 차단됨
# 프로바이더 선택: "gemini" (무료 티어 사용 가능) | "anthropic"
LLM_PROVIDER=gemini
# Gemini: https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=
# Anthropic: https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 모델명은 선택된 프로바이더의 모델명을 그대로 사용
#   gemini    → gemini-2.0-flash(비-thinking, free tier 한도 ↑ 권장)
#             | gemini-2.5-flash(thinking)
#   anthropic → claude-sonnet-4-5 등
LLM_ADVISOR_MODEL=gemini-2.0-flash
LLM_ADVISOR_MIN_CONFIDENCE=70
LLM_ADVISOR_TIMEOUT_SECONDS=20
LLM_ADVISOR_MAX_TOKENS=1024
# advisory 배치 호출(1 run = 1 LLM call) 한도
ADVISORY_BATCH_MAX_TOKENS=4096
ADVISORY_BATCH_TIMEOUT_SECONDS=60
# 주간 메타 분석 모델 (llm_provider에 맞춰 설정)
META_ANALYSIS_MODEL=gemini-2.0-flash

# 원클릭 분석·매매 (Advisory) 안전 한도
# 1회 run 예산 절대 상한(원), 후보 종목 수 상한, 종목당 비중 상한(0~1), 결과 TTL(분)
ADVISORY_MAX_RUN_BUDGET_KRW=1000000000
ADVISORY_MAX_CANDIDATES=20
ADVISORY_MAX_POSITION_PCT=0.20
ADVISORY_TTL_MINUTES=5

# 개발 환경
ENV=development
