# 데이터베이스
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wealthpilot_dev

# 암호화 (AES-256, 32바이트 base64 인코딩 키)
# 생성 방법: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=your-base64-encoded-32byte-key-here

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# NextAuth 연동
NEXTAUTH_SECRET=

# CORS (프론트엔드 URL, 쉼표 구분)
CORS_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry
SENTRY_DSN=

# 개발용: 인증 비활성화 (true면 로그인 없이 API 사용 가능)
AUTH_DISABLED=false

# 싱글유저 모드: 허용된 이메일 (설정하면 이 이메일만 로그인 가능, 비워두면 제한 없음)
ALLOWED_EMAIL=

# KIS API (한국투자증권) — 모의투자
KIS_PAPER_ACCOUNT_NUMBER=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# KIS API (한국투자증권) — 실전
KIS_LIVE_ACCOUNT_NUMBER=
KIS_LIVE_ACCOUNT_PRODUCT_CODE=
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=

# 자동매매 글로벌 킬 스위치 (true=활성)
TRADING_ENABLED=false

# 개발 환경
ENV=development
